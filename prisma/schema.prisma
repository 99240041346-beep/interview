generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  name         String
  email        String             @unique
  passwordHash String
  targetRole   String             @default("Software Developer")
  department   String             @default("CSE")
  createdAt    DateTime           @default(now())
  progress     LearningProgress[]
  practices    PracticeAttempt[]
  interviews   MockInterview[]
  resumes      Resume[]
  notes        Note[]
  moduleProgress ModuleProgress[]
  certificates Certificate[]
}

model LearningProgress {
  id        String   @id @default(cuid())
  userId    String
  topic     String
  score     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
}

model PracticeAttempt {
  id        String   @id @default(cuid())
  userId    String
  type      String
  topic     String
  score     Int      @default(0)
  total     Int      @default(10)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model MockInterview {
  id          String   @id @default(cuid())
  userId      String
  role        String
  mode        String   @default("text")
  score       Int      @default(0)
  feedback    String   @default("")
  transcript  String   @default("")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Resume {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  extracted   String   @default("")
  score       Int      @default(0)
  feedback    String   @default("")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ModuleProgress {
  id          String   @id @default(cuid())
  userId      String
  department  String
  course      String
  moduleId    String
  completed   Boolean  @default(false)
  examScore   Int      @default(0)
  examPassed  Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId, department, course])
}

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  department  String
  course      String
  certificateNo String @unique
  issuedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, course])
}
